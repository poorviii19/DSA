// method-1: 

class Solution {
public:
    string reverseWords(string s) {

        int start = 0;

        for(int end = 0; end <= s.size(); end++) {
            if(end == s.size() || s[end] == ' ') {

                reverse(s.begin() + start, s.begin() + end);

                start = end + 1;
            }
        }

        return s;
    }
};


// method-2: using stringstream

class Solution {
public:
    string reverseWords(string s) {
        vector<string> temp;
        stringstream ss(s);
        string word;
        while(ss>>word){
            temp.push_back(word);
        }
        string result = "";
        for(int i =0;i<temp.size();i++){
           if (i > 0) result += " ";
            string rev = temp[i];
            reverse(rev.begin(), rev.end());
            result += rev;

        }

        return result;
    }
};
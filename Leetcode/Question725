class Solution {
public:
    vector<ListNode*> splitListToParts(ListNode* head, int k) {

        int n = 0;
        ListNode* curr = head;

        while (curr != nullptr) {
            n++;
            curr = curr->next;
        }

        int baseSize = n / k;
        int extra = n % k;

        vector<ListNode*> ans(k);

        curr = head;

        for (int i = 0; i < k; i++) {

            int partSize = baseSize + (i < extra ? 1 : 0);

            if (partSize == 0) {
                ans[i] = nullptr;
                continue;
            }
            ans[i] = curr;
            for (int j = 1; j < partSize; j++) {
                curr = curr->next;
            }
            ListNode* nextPart = curr->next;

            curr->next = nullptr;
            curr = nextPart;
        }

        return ans;
    }
};
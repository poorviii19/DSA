class Solution {
public:
    int ans(vector<int>& nums, int target, int n){
        int left = 0;
        int right = n-1;
        while(left<=right){
            int mid = left+(right-left)/2;

            if(nums[mid]==target){
                return 1;
            } 
            if (nums[left] == nums[mid] && nums[mid] == nums[right]) {
                left++;
                right--;
            }
            else if(nums[left]<=nums[mid]){
                if(target>=nums[left] && target < nums[mid]){
                    right = mid-1;
                }
                else{
                    left = mid+1;
                }
            }
            else{
                if(target<=nums[right] && target>nums[mid]){
                    left = mid+1;
                }
                else{
                    right = mid-1;
                }
            }
        }

        return 0;

    }
    bool search(vector<int>& nums, int target) {
       return ans(nums, target, nums.size());

    }
};
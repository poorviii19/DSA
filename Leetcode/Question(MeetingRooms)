class Solution {
  public:
    bool canAttend(vector<vector<int>> &arr) {
        // Code Here
        sort(arr.begin(), arr.end());
        int n = arr.size();
        int prevEnd = arr[0][1];
        for(int i =1;i<n;i++){
            int currS = arr[i][0];
            int currE = arr[i][1];
            int lastE = prevEnd;
            
            if(currS<prevEnd){
                return false;
            }
            
            prevEnd = currE;
        }
        
        return true;
    }
};
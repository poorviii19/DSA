class Solution {
public:
    vector<int> frequencySort(vector<int>& nums) {
        int n = nums.size();
        
        int freq[201] = {0};
        for(int i =0;i<n;i++){
            freq[nums[i]+100]++;
        }

        for(int i =0;i<n;i++){
            for(int j = i+1;j<n;j++){
                if(freq[nums[i]+100]>freq[nums[j]+100] || (freq[nums[i]+100] ==freq[nums[j]+100]  && nums[i]<nums[j])){
                    int temp = nums[i];
                    nums[i] = nums[j];
                    nums[j] = temp;

                }

            }

        }
        return nums;
    }
};
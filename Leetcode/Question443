class Solution {
public:
    int compress(vector<char>& chars) {
    int i = 0, k = 0;        
    while (i < chars.size()) {
        char curr = chars[i];
        int count = 0;
        while (i < chars.size() && chars[i] == curr) {
            count++;
            i++;
        }

        chars[k++] = curr;   

            if (count > 1) {
                string cnt = to_string(count);
                for (char c : cnt) {
                    chars[k++] = c;
                }
            }
    }
        return k;
    }


};
class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        vector<int> ans;

        int k  = p.size();
        int m = s.size();
        if(k>m){
            return ans;
        }


        unordered_map<char,int> mp,mp1;
        for(int i =0;i<k;i++){
            mp[p[i]]++;
        }
        for(int i = 0;i<m;i++){
            mp1[s[i]]++;
            if(i>=k){
                mp1[s[i-k]]--;
                if(mp1[s[i-k]]==0){
                    mp1.erase(s[i-k]);
                }
            }

            if(mp == mp1){
                ans.push_back(i-k+1);
            }
        }

        return ans;
    }
};
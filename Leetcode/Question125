class Solution {
public:


    bool isPalindrome(string s) {
        string s1 ="";
        for(char ch: s){
         if(isalnum(ch)){
                s1 += tolower(ch);
            }

        }
        string rev = s1;
        reverse(rev.begin(), rev.end());

        return rev == s1;

        
    }
};



// Method-2:
class Solution {
public:
    bool isPalindrome(string s) {
        int l = 0;
        int r = s.length()-1;

        while(l<r){
            while(l<r && !isalnum(s[l])) l++;
            while(l<r && !isalnum(s[r])) r--;

            if(tolower(s[l]) != tolower(s[r])){
                return false;
            }
            l++;
            r--;
        }
        return true;
    }
};
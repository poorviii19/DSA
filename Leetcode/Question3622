class Solution {
public:
    int digitSum(int n){
        int sum = 0;
        while(n>0){
            int digit =  n%10;
            sum+=digit;
            n/=10;
        }

        return sum;
    }
    int digitProduct(int n){
        int product = 1;
        while(n>0){
            int digit =  n%10;
            product*=digit;
            n/=10;
        }

        return product;
    }

    bool checkDivisibility(int n) {
        int a = digitSum(n);
        int b = digitProduct(n);

        int sum =  a+b;

        if(n%sum == 0){
            return true;
        }else{

        return false;
        }
    }
};
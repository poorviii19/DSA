class Solution {
public:
    int vowelConsonantScore(string s) {

        int vCount = 0;
        int cCount = 0;

        for(int i = 0; i < s.size(); i++) {

            if(isalpha(s[i]) && s[i] == 'a' || s[i] == 'e' ||
               s[i] == 'i' || s[i] == 'o' ||
               s[i] == 'u') {

                vCount++;
            }
            else if(isalpha(s[i])) {
                cCount++;
            }
        }

        if(cCount <= 0) return 0;

        return vCount / cCount;
    }
};
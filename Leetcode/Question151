class Solution {
public:
    string reverseWords(string s) {
        vector<string> temp;
        stringstream ss(s);
        string word;
        while(ss>>word){
            temp.push_back(word);
        }

        int l =0;
        int r = temp.size()-1;
        while(l<r){
            swap(temp[l],temp[r]);
            l++;
            r--;
        }

        string result = "";
        for(int i =0;i<temp.size();i++){
            result += temp[i];
            if(i != temp.size() - 1)
             result += " ";
        }

        return result;
    }
};
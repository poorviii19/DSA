class Solution {
public:
    int maxPower(string s) {
        int power = 1;
        int maxP = 1;
        for(int i =1; i<s.size();i++){
            if(s[i] == s[i-1] ) {
                power++;
                maxP = max(maxP, power);
            }
            else{
                power = 1;
            }

        }
        return maxP;
    }
};
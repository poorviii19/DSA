class MinStack {
public:

stack<int> st;
stack<int> minstack;
    MinStack() {
        
    }
    
    void push(int val) {
        if(!st.empty()){
            st.push(val);
            if(val<minstack.top()){
                minstack.push(val);
            }
            else{
                minstack.push(minstack.top());
            }
        }
        else{
            st.push(val);
            minstack.push(val);
        }
    }
    
    void pop() {
       st.pop();
       minstack.pop(); 
    }
    
    int top() {
        return st.top();
    }
    
    int getMin() {
        return minstack.top();
    }
};


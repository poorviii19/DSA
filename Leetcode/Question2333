class Solution {
public:
    long long minSumSquareDiff(vector<int>& nums1, vector<int>& nums2, int k1, int k2) {
        int n = nums1.size();
        long long k = (long long)k1 + k2;
        vector<int> diff(n);

        int mx = 0;
        long long sum = 0;

        for (int i = 0; i < n; i++) {
            diff[i] = abs(nums1[i] - nums2[i]);
            mx = max(mx, diff[i]);
            sum += diff[i];
        }

        if (sum <= k) return 0;

        vector<int> freq(mx + 1, 0);

        for (int x : diff) {
            freq[x]++;
        }

        for (int i = mx; i > 0 && k > 0; i--) {
            if (freq[i] == 0) continue;

            int count = min((long long)freq[i], k);

            freq[i] -= count;
            freq[i - 1] += count;
            k -= count;
        }

        long long ans = 0;

        for (int i = 1; i <= mx; i++) {
            ans += 1LL * i * i * freq[i];
        }

        return ans;
    }
};
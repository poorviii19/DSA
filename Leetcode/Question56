class Solution {
public:
    void swapIntervals(vector<vector<int>>& intervals, int size){
        for(int i =0;i<size;i++){
            for(int j =0;j<size-i-1;j++){
                if(intervals[j][0]>intervals[j+1][0]){
                    swap(intervals[j][0],intervals[j+1][0]);
                    swap(intervals[j][1],intervals[j+1][1]);
                }
            }
        }
    }
    vector<vector<int>> merge(vector<vector<int>>& intervals) {
        int size = intervals.size();
        swapIntervals(intervals, size);
        vector<vector<int>> merged(size, vector<int>(2));
        int count = 0;
        merged[0][0] = intervals[0][0];
        merged[0][1] = intervals[0][1];

        count = 1;


        for(int i =1;i<size;i++){
            int currStart = intervals[i][0];
            int currEnd = intervals[i][1];
            int lastEnd = merged[count-1][1];

            if(currStart<=lastEnd){
                merged[count-1][1] = max(currEnd, lastEnd);
            }
            else{
                merged[count][0] = currStart;
                merged[count][1] = currEnd;

                count++;
            }
        }
        merged.resize(count);
        return merged;       

    }
};
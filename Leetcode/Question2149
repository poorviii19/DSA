class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        int n= nums.size();
        vector<int> P, N, R(n);
        for(int i=0;i<n;i++){
            if(nums[i]>=0){
                P.push_back(nums[i]);
            }
            else
                N.push_back(nums[i]);
        }
        int i=0,j=0;
        for(int k=0;k<n;k += 2){
            R[k] = P[i++];
            R[k + 1] = N[j++];
        }
        return R;
    }
};
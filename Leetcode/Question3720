class Solution {
public:
    string lexGreaterPermutation(string s, string target) {
        int n = s.size();

        vector<int> freq(26, 0);
        for (char c : s) {
            freq[c - 'a']++;
        }

        string ans;
        for (int i = 0; i < n; i++) {
            int x = target[i] - 'a';
            if (freq[x] > 0) {
                ans += target[i];
                freq[x]--;
                continue;
            }
            for (int c = x + 1; c < 26; c++) {
                if (freq[c] > 0) {
                    ans += char('a' + c);
                    freq[c]--;
                    for (int j = 0; j < 26; j++) {
                        ans += string(freq[j], char('a' + j));
                    }

                    return ans;
                }
            }
            break;
        }

        for (int i = (int)ans.size() - 1; i >= 0; i--) {

            freq[ans[i] - 'a']++;

            int x = ans[i] - 'a';

            for (int c = x + 1; c < 26; c++) {
                if (freq[c] > 0) {

                    string result = ans.substr(0, i);
                    result += char('a' + c);
                    freq[c]--;

                    for (int j = 0; j < 26; j++) {
                        result += string(freq[j], char('a' + j));
                    }

                    return result;
                }
            }
        }

        return "";
    }
};
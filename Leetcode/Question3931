class Solution {
public:
    bool isAdjacentDiffAtMostTwo(string s) {
        int count = 0;
        for(int i =0;i<s.size();i++){
            if(abs((s[i+1]-'0')- (s[i]-'0'))<=2){
                count++;
            }
        }
        if(count == s.size()-1){
            return true;
        }
        return false;
    }
};
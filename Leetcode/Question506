class Solution {
public:
    vector<string> findRelativeRanks(vector<int>& score) {

        int n = score.size();

        vector<pair<int, int>> ans;
        for (int i = 0; i < n; i++) {
            ans.push_back({score[i], i});
        }

        sort(ans.begin(), ans.end(),
             [](pair<int, int>& a, pair<int, int>& b) {
                 return a.first > b.first;
             });

        vector<string> result(n);

        for (int i = 0; i < n; i++) {

            int Index1 = ans[i].second;

            if (i == 0) {
                result[Index1] = "Gold Medal";
            }
            else if (i == 1) {
                result[Index1] = "Silver Medal";
            }
            else if (i == 2) {
                result[Index1] = "Bronze Medal";
            }
            else {
                result[Index1] = to_string(i + 1);
            }
        }

        return result;
    }
};
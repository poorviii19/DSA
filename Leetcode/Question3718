class Solution {
public:
    int missingMultiple(vector<int>& nums, int k) {
        int n = nums.size();

        for (int i = 1; i <= n + 1; i++) {
            int multiple = i * k;
            bool found = false;

            for (int x : nums) {
                if (x == multiple) {
                    found = true;
                    break;
                }
            }

            if (!found)
                return multiple;
        }

        return -1;
    }
};
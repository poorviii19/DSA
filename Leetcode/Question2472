class Solution {
public:
    int maxPalindromes(string s, int k) {
        int n = s.size();
        vector<int> dp(n + 1, 0);

        for (int i = 0; i < n; i++) {
            dp[i + 1] = dp[i];

            for (int len = k; i - len + 1 >= 0; len++) {
                int l = i - len + 1;
                bool ok = true;

                for (int a = l, b = i; a < b; a++, b--) {
                    if (s[a] != s[b]) {
                        ok = false;
                        break;
                    }
                }

                if (ok) {
                    dp[i + 1] = max(dp[i + 1], dp[l] + 1);
                    break;
                }
            }
        }

        return dp[n];
    }
};
class Solution {
public:

    void transpose(vector<vector<int>>&matrix, int n){
        for(int i =0;i<n;i++){
            for(int j = i+1;j<n;j++){
                swap(matrix[i][j], matrix[j][i]);
            }
        }
    }


    
    void rotate(vector<vector<int>>& matrix) {
        int n = matrix.size();
        transpose(matrix, n);


        for(int i =0;i<n;i++){

                int left = 0;
                int right = matrix.size()-1;

            while(left<right){
                swap(matrix[i][left],matrix[i][right]);
                left++;
                right--;
            }
        }
    }
};
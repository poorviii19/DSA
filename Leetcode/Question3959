class Solution {
public:
    bool checkGoodInteger(int n) {
        int digit = 0;
        int digitSum = 0;
        int squareSum = 0;
        while(n>0){
            digit = n%10;
            digitSum += digit;
            squareSum += (digit*digit);
            n/=10;
        }

        if(squareSum-digitSum >= 50) return true;
        return false;
    }
};
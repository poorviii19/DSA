class Solution {
public:
    void nextPermutation(vector<int>& nums) {
        int n = nums.size();

        // Find the first index from the right where nums[i] < nums[i+1]
        int i = n - 2;
        while (i >= 0 && nums[i] >= nums[i + 1]) {
            i--;
        }

        // If such an index exists, find the next greater element from the right
        if (i >= 0) {
            int j = n - 1;
            while (nums[j] <= nums[i]) {
                j--;
            }
            swap(nums[i], nums[j]);
        }

        // Reverse the suffix
        reverse(nums.begin() + i + 1, nums.end());
    }
};
class Solution {
public:
    int minimumJumps(vector<int>& forbidden, int a, int b, int x) {
        int limit = 6000;

        vector<bool> blocked(limit + 1, false);
        for (int pos : forbidden) {
            blocked[pos] = true;
        }

        queue<pair<int, int>> q;
        vector<vector<bool>> visited(limit + 1, vector<bool>(2, false));

        q.push({0, 0});
        visited[0][0] = true;

        int jumps = 0;

        while (!q.empty()) {
            int size = q.size();

            while (size--) {
                auto [pos, back] = q.front();
                q.pop();

                if (pos == x)
                    return jumps;

                int forward = pos + a;

                if (forward <= limit &&
                    !blocked[forward] &&
                    !visited[forward][0]) {

                    visited[forward][0] = true;
                    q.push({forward, 0});
                }

                int backward = pos - b;

                if (back == 0 &&
                    backward >= 0 &&
                    !blocked[backward] &&
                    !visited[backward][1]) {

                    visited[backward][1] = true;
                    q.push({backward, 1});
                }
            }

            jumps++;
        }

        return -1;
    }
};